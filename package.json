{
  "name": "media-sdk-workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc -p packages/media-core && tsc -p packages/media-react && tsc -p packages/media-ui-react && pnpm --filter app typecheck",
    "test": "node --import tsx --test packages/media-core/test/*.test.ts",
    "verify": "pnpm check:boundaries && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
